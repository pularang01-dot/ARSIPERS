# Salin menjadi .env.local lalu isi. JANGAN commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Hanya server. JANGAN diberi awalan NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# URL publik aplikasi (untuk tautan undangan pengguna)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Batas ukuran lampiran dalam MB (menunggu konfirmasi sekolah)
MAX_UPLOAD_MB=5
